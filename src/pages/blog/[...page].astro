---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import { BLOG_PAGE_SIZE } from "../../consts";
import BlogList from "../../layouts/BlogList.astro";

type PostItem = { url: string; title: string; pubDate: Date; tags?: string[] };

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts: PostItem[] = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => ({
      url: `/blog/${p.id}/`,
      title: p.data.title,
      pubDate: p.data.pubDate,
      tags: p.data.tags,
    }));
  return paginate(posts, { pageSize: BLOG_PAGE_SIZE });
};

type Props = { page: Page<PostItem> };
const { page } = Astro.props;
---

<BlogList
  title="Blog"
  description="A space where I publish notes about software development, design, tech and updates about my personal life."
  posts={page.data}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
/>
