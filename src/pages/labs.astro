---
import { getCollection } from "astro:content";
import Default from "../layouts/Default.astro";
import Heading from "../components/shared/Heading.astro";
import LabsCard from "../components/labs/LabsCard.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";

const labsEntries = await getCollection("labs");
const sortedLabs = labsEntries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Default>
  <Heading
    title="Labs"
    description="Laboratory with tools, plugins and other resources I build for fun.<br />All these projects are public and open source."
  />
  <section class="labs fade-up-animation">
    <div class="labs-inner">
      {
        sortedLabs.map((entry) => (
          <LabsCard
            title={entry.data.title}
            description={entry.data.description}
            tools={entry.data.tools}
            image={entry.data.heroImage}
            url={entry.data.url}
          />
        ))
      }
    </div>
  </section>
  <ContactBanner />
</Default>

<style>
  .labs {
    --padding-block: 16px;
    padding-block: var(--padding-block);
    animation-delay: 1s;

    @media (min-width: 1024px) {
      --padding-block: 32px;
    }
  }

  .labs-inner {
    --gap: 48px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    max-width: 1312px;
    margin-inline: auto;

    @media (min-width: 1024px) {
      --gap: 80px;
    }
  }
</style>
