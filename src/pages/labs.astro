---
import { getCollection } from "astro:content";
import Default from "../layouts/Default.astro";
import Heading from "../components/shared/Heading.astro";
import LabsCard from "../components/labs/LabsCard.astro";
import LabsEntriesSection from "../components/labs/LabsEntriesSection.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";

const labsEntries = await getCollection("labs");
const sortedLabs = labsEntries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Default>
  <Heading
    title="Labs"
    description="Laboratory with tools, plugins and other resources I build for fun.<br />All these projects are public and open source."
  />
  <LabsEntriesSection>
    {
      sortedLabs.map((entry) => (
        <LabsCard
          title={entry.data.title}
          description={entry.data.description}
          tags={entry.data.tags}
          image={entry.data.heroImage}
          url={`/labs/${entry.id}/`}
        />
      ))
    }
  </LabsEntriesSection>
  <ContactBanner />
</Default>
