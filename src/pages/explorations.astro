---
import { getCollection } from "astro:content";
import Default from "../layouts/Default.astro";
import Heading from "../components/shared/Heading.astro";
import LabsCard from "../components/labs/LabsCard.astro";
import LabsEntriesSection from "../components/labs/LabsEntriesSection.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";
import type { WithContext, CollectionPage } from "schema-dts";
import { SCHEMA_ORG } from "../consts";

const EXPLORATIONS_TITLE = "Explorations";
const EXPLORATIONS_DESCRIPTION =
  "Designs, prototypes, and exploration of ideas that I work on for inspiration or simply just for fun.";

const schema: WithContext<CollectionPage> = {
  "@context": SCHEMA_ORG,
  "@type": "CollectionPage",
  name: EXPLORATIONS_TITLE,
  description: EXPLORATIONS_DESCRIPTION,
  url: new URL("/explorations/", Astro.site).toString(),
};

const explorationsEntries = await getCollection("explorations");
const sortedExplorations = explorationsEntries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Default title={EXPLORATIONS_TITLE} description={EXPLORATIONS_DESCRIPTION} {schema}>
  <Heading title={EXPLORATIONS_TITLE} description={EXPLORATIONS_DESCRIPTION} />
  <LabsEntriesSection label="Explorations projects">
    {
      sortedExplorations.map((entry) => (
        <LabsCard
          title={entry.data.title}
          description={entry.data.description}
          tags={entry.data.tags}
          image={entry.data.heroImage}
          url={`/explorations/${entry.id}/`}
        />
      ))
    }
  </LabsEntriesSection>
  <ContactBanner />
</Default>
