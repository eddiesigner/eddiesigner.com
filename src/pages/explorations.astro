---
import { getCollection } from "astro:content";
import Default from "../layouts/Default.astro";
import Heading from "../components/shared/Heading.astro";
import LabsCard from "../components/labs/LabsCard.astro";
import LabsEntriesSection from "../components/labs/LabsEntriesSection.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";

const explorationsEntries = await getCollection("explorations");
const sortedExplorations = explorationsEntries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Default>
  <Heading
    title="Explorations"
    description="Designs, prototypes, and exploration of ideas that I work on for inspiration or simply just for fun."
  />
  <LabsEntriesSection>
    {
      sortedExplorations.map((entry) => (
        <LabsCard
          title={entry.data.title}
          description={entry.data.description}
          tools={entry.data.tools}
          image={entry.data.heroImage}
          url={`/explorations/${entry.id}/`}
        />
      ))
    }
  </LabsEntriesSection>
  <ContactBanner />
</Default>
