---
import Default from "../layouts/Default.astro";
import Hero from "../components/home/Hero.astro";
import Work from "../components/home/Work.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";
import type { WithContext, WebSite } from "schema-dts";

const schema: WithContext<WebSite> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Eduardo Gómez",
  url: Astro.site?.toString(),
  author: {
    "@type": "Person",
    name: "Eduardo Gómez",
    jobTitle: "Frontend Engineer & UI/UX Designer",
    url: Astro.site?.toString(),
  },
};
---

<Default {schema}>
  <Hero />
  <Work />
  <ContactBanner />
</Default>
