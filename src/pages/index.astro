---
import Default from "../layouts/Default.astro";
import Hero from "../components/home/Hero.astro";
import Work from "../components/home/Work.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";
import type { WithContext, WebSite } from "schema-dts";
import { SITE_AUTHOR, SCHEMA_ORG } from "../consts";

const schema: WithContext<WebSite> = {
  "@context": SCHEMA_ORG,
  "@type": "WebSite",
  name: SITE_AUTHOR,
  url: Astro.site?.toString(),
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    jobTitle: "Frontend Engineer & UI/UX Designer",
    url: Astro.site?.toString(),
  },
};
---

<Default {schema}>
  <Hero />
  <Work />
  <ContactBanner />
</Default>
