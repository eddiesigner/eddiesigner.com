---
import BaseHead from "../components/shared/BaseHead.astro";
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import Button from "../components/ui/Button.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const video = document.querySelector(".bg-video");
        if (video) {
          video.load();
          video.play().catch(() => {});
        }
      });
    </script>
  </head>
  <body>
    <video class="bg-video" autoplay muted loop playsinline>
      <source src="/video/glitch.mp4" type="video/mp4" />
    </video>
    <Header />
    <main class="page-404">
      <div class="page-404-inner fade-up-animation">
        <div class="page-404-content">
          <h1 class="page-404-title">Error 404</h1>
          <p class="page-404-description">
            Unfortunately the page you were looking for could not be found or
            does not exist.
          </p>
        </div>
        <Button url="/" label="Back to home" />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  :global(.header.header) {
    background: transparent;
    backdrop-filter: none;
    border-bottom: 1px solid var(--alt-background);
  }

  .bg-video {
    position: fixed;
    inset: -8px;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
    filter: blur(8px);
    pointer-events: none;
    z-index: -1;
  }

  .page-404 {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .page-404-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding-inline: 20px;
    padding-block-start: 64px;
    padding-block-end: 96px;
    max-width: 560px;

    @media (min-width: 720px) {
      padding-block: 96px;
    }

    .button {
      align-self: center;
    }
  }

  .page-404-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .page-404-title {
    --font-size: 1.75rem;
    color: var(--foreground);
    line-height: 1.3;
    font-size: var(--font-size);
    font-weight: 500;

    @media (min-width: 720px) {
      --font-size: 2rem;
    }
  }

  .page-404-description {
    --font-size: 1rem;
    color: var(--light-text);
    line-height: 1.6;
    font-size: var(--font-size);
    font-weight: 500;

    @media (min-width: 720px) {
      --font-size: 1.25rem;
    }
  }
</style>
