---
import FormattedDate from "./FormattedDate.astro";
import Tag from "../shared/Tag.astro";

interface Props {
  url: string;
  title: string;
  pubDate: Date;
  tags?: string[];
}

const { url, title, pubDate, tags } = Astro.props;
---

<article class="post-entry break-out">
  <div class="post-entry-inner">
    <div class="post-entry-date">
      <FormattedDate date={pubDate} />
    </div>
    <div class="post-entry-content">
      <a class="post-entry-title" href={url}>{title}</a>
      {tags?.[0] && (
          <Tag
            label={tags[0]}
            url={`/tag/${tags[0].toLowerCase().replace(/\s+/g, "-")}/`}
          />
        )}
    </div>
  </div>
</article>

<style>
  .post-entry {
    --padding-block: 16px;
    border-top: 1px solid var(--alt-background);
    padding-block: var(--padding-block);

    @media (min-width: 720px) {
      --padding-block: 32px;
    }

    &:last-child {
      border-bottom: 1px solid var(--alt-background);
    }
  }

  .post-entry-inner {
    --flex-direction: column;
    --gap: 4px;
    display: flex;
    flex-direction: var(--flex-direction);
    gap: var(--gap);

    @media (min-width: 720px) {
      --flex-direction: row;
      --gap: 32px;
      align-items: flex-start;
      max-width: var(--max-width);
      margin-inline: auto;
    }
  }

  .post-entry-date {
    --font-size: 0.875rem;
    --line-height: 1.5;
    font-size: var(--font-size);
    font-weight: 400;
    line-height: var(--line-height);
    color: var(--light-text);
    flex-shrink: 0;

    @media (min-width: 720px) {
      --font-size: 1rem;
      --line-height: 1.3;
    }
  }

  .post-entry-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;

    @media (min-width: 720px) {
      max-width: var(--wide-content-width);
      margin-inline: auto;
    }
  }

  .post-entry-title {
    --font-size: 1.375rem;
    --line-height: 1.4;
    font-size: var(--font-size);
    font-weight: 500;
    line-height: var(--line-height);
    color: var(--foreground);
    text-decoration: none;
    transition: color 0.2s ease-in-out;

    @media (min-width: 720px) {
      --font-size: 2rem;
      --line-height: 1.2;
    }

    &:hover {
      color: var(--accent);
    }
  }
</style>
