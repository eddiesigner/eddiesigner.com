---
import type { ImageMetadata } from "astro";
import CardOverlay from "../shared/CardOverlay.astro";

interface Props {
  title: string;
  slug: string;
  heroImage: ImageMetadata;
  type: string;
  year: string;
}

const { title, slug, heroImage, type, year } = Astro.props;
const url = `/work/${slug}/`;
---

<article class="work-card">
  <CardOverlay url={url} image={heroImage} alt={title} />
  <div class="work-card-info">
    <a href={url} class="work-card-title">{title}</a>
    <p class="work-card-meta">{type} / {year}</p>
  </div>
</article>

<style>
  .work-card {
    --gap: 16px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);

    @media (min-width: 720px) {
      --gap: 24px;
    }
  }

  .work-card-info {
    --gap: 4px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);

    @media (min-width: 720px) {
      --gap: 8px;
    }
  }

  .work-card-title {
    --font-size: 1.375rem;
    font-size: var(--font-size);
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.2s ease-in-out;

    @media (min-width: 720px) {
      --font-size: 1.5rem;
    }

    &:hover {
      color: var(--accent);
    }
  }

  .work-card-meta {
    --font-size: 0.875rem;
    font-size: var(--font-size);
    font-weight: 500;
    color: var(--light-text);

    @media (min-width: 720px) {
      --font-size: 1rem;
    }
  }
</style>
