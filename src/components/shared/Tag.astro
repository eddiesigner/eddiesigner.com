---
interface Props {
  label: string;
  url?: string;
}

const { label, url } = Astro.props;
const Element = url ? "a" : "span";
---

<Element class="tag" href={url}>{label}</Element>

<style>
  .tag {
    padding: 1px 5px;
    background: var(--alt-background);
    border-radius: 2px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--light-text);
    align-self: flex-start;
    text-decoration: none;
  }

  a.tag {
    transition: opacity 0.2s ease-in-out;

    &:hover {
      opacity: 0.75;
    }
  }
</style>
