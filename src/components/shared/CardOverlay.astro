---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../ui/Icon.astro";

interface Props {
  url: string;
  image: ImageMetadata;
  alt: string;
  withBorder?: boolean;
}

const { url, image, alt, withBorder = false } = Astro.props;
---

<a href={url} class:list={["card-image-link", { "with-border": withBorder }]}>
  <Image
    class="card-image"
    src={image}
    alt={alt}
    widths={[400, 800, 1200]}
    sizes="(min-width: 720px) 50vw, 100vw"
  />
  <div class="card-overlay" aria-hidden="true">
    <div class="card-overlay-content">
      <span>See project</span>
      <span>
        <Icon id="arrow-right" size={16} />
      </span>
    </div>
  </div>
</a>

<style>
  .card-image-link {
    display: block;
    position: relative;
    overflow: hidden;

    &:hover {
      .card-overlay {
        opacity: 1;
      }

      .card-overlay-content {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .with-border {
    --padding: 20px;
    border: 1px dashed var(--alt-background);
    padding: var(--padding);
    max-width: 740px;

    @media (min-width: 720px) {
      flex: 1;
    }

    @media (min-width: 1024px) {
      --padding: 32px;
    }
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
  }

  .card-overlay {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }

  .card-overlay-content {
    --font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--foreground);
    font-size: var(--font-size);
    font-weight: 500;
    opacity: 0;
    transform: translateY(32px);
    filter: blur(6px);
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out,
      filter 0.3s ease-in-out;

    @media (min-width: 720px) {
      --font-size: 1rem;
    }

    & span:last-child {
      color: var(--accent);
    }
  }
</style>
