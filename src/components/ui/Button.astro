---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  url: string;
  label: string;
  small?: boolean;
  external?: boolean;
  noIcon?: boolean;
}

const { url, label, small, external, noIcon, ...attrs } = Astro.props;

import Icon from "./Icon.astro";
---

<a
  class:list={["button", { small }]}
  href={url}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...attrs}
>
  {label}
  {!noIcon && <Icon id="arrow-right" size={20} />}
</a>

<style>
  .button {
    --font-size: 1.125rem;
    --padding: 16px 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    appearance: none;
    text-decoration: none;
    border: none;
    cursor: pointer;
    color: var(--background);
    line-height: 1.2;
    font-size: var(--font-size);
    border-radius: 100px;
    padding: var(--padding);
    background-image: linear-gradient(
      to bottom right,
      var(--accent) 50%,
      var(--foreground) 50%
    );
    background-size: 200% 200%;
    background-position: 100% 100%;
    transition:
      background-position 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);

    @media (min-width: 1024px) {
      --font-size: 1.5rem;
      --padding: 24px 40px;
    }

    &:hover {
      background-position: 0% 0%;
      transform: scale(1.04);
    }

    &.small {
      --font-size: 0.875rem;
      --padding: 12px 16px;
      font-weight: 500;

      @media (min-width: 1024px) {
        --font-size: 1rem;
      }
    }
  }
</style>
