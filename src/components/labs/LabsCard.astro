---
import type { ImageMetadata } from "astro";
import Tag from "../shared/Tag.astro";
import CardOverlay from "../shared/CardOverlay.astro";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  image: ImageMetadata;
  url: string;
}

const { title, description, tags, image, url } = Astro.props;
---

<article class="labs-card">
  <div class="labs-card-content">
    <div class="labs-card-info">
      <a href={url} class="labs-card-title">{title}</a>
      <p class="labs-card-description" set:html={description} />
    </div>
    <div class="labs-card-tags">
      {tags?.map((tag) => <Tag label={tag} />)}
    </div>
  </div>
  <CardOverlay url={url} image={image} alt={title} withBorder />
</article>

<style>
  .labs-card {
    --flex-direction: column;
    display: flex;
    flex-direction: var(--flex-direction);
    gap: 24px;
    width: 100%;

    @media (min-width: 720px) {
      --flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .labs-card-content {
    --gap: 16px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);

    @media (min-width: 720px) {
      --gap: 24px;
      width: 320px;
      flex-shrink: 0;
    }
  }

  .labs-card-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .labs-card-title {
    --font-size: 1.375rem;
    --line-height: 1.4;
    font-size: var(--font-size);
    font-weight: 500;
    line-height: var(--line-height);
    color: var(--foreground);
    text-decoration: none;
    transition: color 0.2s ease-in-out;

    @media (min-width: 720px) {
      --font-size: 1.5rem;
      --line-height: 1.2;
    }

    &:hover {
      color: var(--accent);
    }
  }

  .labs-card-description {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--light-text);

    a {
      color: inherit;
      text-decoration: underline;
      text-decoration-style: dotted;
      transition: color 0.2s ease-in-out;

      &:hover {
        color: var(--foreground);
      }
    }
  }

  .labs-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
