---
import Default from "./Default.astro";
import Heading from "../components/shared/Heading.astro";
import PostEntry from "../components/blog/PostEntry.astro";
import Pagination from "../components/blog/Pagination.astro";
import ContactBanner from "../components/shared/ContactBanner.astro";
import type { WithContext, CollectionPage } from "schema-dts";
import { SCHEMA_ORG } from "../consts";

interface PostItem {
  url: string;
  title: string;
  pubDate: Date;
  tags?: string[];
}

interface Props {
  title: string;
  description?: string;
  posts: PostItem[];
  prevUrl: string | undefined;
  nextUrl: string | undefined;
}

const { title, description, posts, prevUrl, nextUrl } = Astro.props;

const schema: WithContext<CollectionPage> = {
  "@context": SCHEMA_ORG,
  "@type": "CollectionPage",
  name: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Default {title} {description} {schema}>
  <Heading {title} {description} />
  <div class="posts-container fade-up-animation">
    <section class="posts" aria-label="Blog posts">
      {
        posts.map((post) => (
          <PostEntry
            url={post.url}
            title={post.title}
            pubDate={post.pubDate}
            tags={post.tags}
          />
        ))
      }
    </section>
    <Pagination {prevUrl} {nextUrl} />
  </div>
  <ContactBanner />
</Default>

<style>
  .posts-container {
    --gap: 40px;
    --pading-block: 16px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding-block: var(--pading-block);
    animation-delay: 1s;

    @media (min-width: 720px) {
      --gap: 64px;
      --pading-block: 32px;
    }
  }

  .posts {
    margin-inline: calc(50% - 50vw);
    width: 100vw;
  }
</style>
